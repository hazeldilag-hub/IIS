 @model InstructorInfoSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In - Instructor Information System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', sans-serif;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .login-container {
            width: 100%;
            max-width: 1000px;
            min-height: 590px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #fff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .10);
        }

        /* LEFT PANEL */

        .brand-panel {
            background: linear-gradient(145deg, #0f172a, #172554, #1e40af);
            color: white;
            padding: 55px 45px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
            right: -120px;
            top: 100px;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
            right: -70px;
            top: 140px;
        }

        .brand-content,
        .brand-bottom,
        .brand-logo {
            position: relative;
            z-index: 1;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .logo-icon {
            width: 48px;
            height: 48px;
            background: rgba(255,255,255,.15);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
        }

        .logo-text {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.3;
        }

        .brand-content {
            margin-top: 70px;
            margin-bottom: 60px;
        }

        .brand-tag {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 30px;
            background: rgba(96,165,250,.16);
            color: #bfdbfe;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 22px;
        }

        .brand-content h1 {
            font-size: 36px;
            font-weight: 750;
            line-height: 1.25;
            margin-bottom: 18px;
        }

        .brand-content p {
            color: #cbd5e1;
            font-size: 14px;
            line-height: 1.9;
            max-width: 340px;
        }

        .brand-bottom {
            color: #94a3b8;
            font-size: 11px;
        }

        /* RIGHT PANEL */

        .form-panel {
            padding: 65px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-heading {
            margin-bottom: 35px;
        }

        .form-heading .small-label {
            color: #2563eb;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            margin-bottom: 12px;
        }

        .form-heading h2 {
            color: #0f172a;
            font-size: 29px;
            font-weight: 750;
            margin-bottom: 10px;
        }

        .form-heading p {
            color: #64748b;
            font-size: 13px;
            margin: 0;
        }

        .form-label {
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 9px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 16px;
            z-index: 2;
        }

        .form-control {
            height: 49px;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 12px 42px;
            font-size: 13px;
            color: #0f172a;
            background: #f8fafc;
            transition: .2s;
        }

        .form-control:focus {
            background: white;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.10);
        }

        .password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #64748b;
            cursor: pointer;
            z-index: 3;
        }

        .btn-login {
            width: 100%;
            height: 49px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 700;
            margin-top: 12px;
            transition: .2s;
        }

        .btn-login:hover {
            background: #1d4ed8;
            box-shadow: 0 6px 16px rgba(37,99,235,.20);
            transform: translateY(-1px);
            color: white;
        }

        .register-section {
            text-align: center;
            margin-top: 27px;
            color: #64748b;
            font-size: 12px;
        }

        .register-link {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
            margin-left: 3px;
        }

        .register-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        .alert {
            font-size: 12px;
            border-radius: 9px;
        }

        .text-danger {
            color: #dc2626 !important;
            font-size: 11px;
        }

        .validation-summary ul {
            margin-bottom: 0;
        }

        /* RESPONSIVE */

        @@media (max-width: 768px) {
            body {
                padding: 15px;
            }

            .login-container {
                grid-template-columns: 1fr;
                max-width: 460px;
            }

            .brand-panel {
                padding: 30px;
                min-height: 220px;
            }

            .brand-content {
                margin: 35px 0 20px;
            }

            .brand-content h1 {
                font-size: 25px;
            }

            .brand-content p {
                font-size: 12px;
            }

            .brand-bottom {
                display: none;
            }

            .form-panel {
                padding: 40px 30px;
            }
        }

        @@media (max-width: 380px) {
            .form-panel {
                padding: 30px 20px;
            }

            .brand-panel {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="login-container">

        <!-- LEFT BRANDING PANEL -->

        <div class="brand-panel">

            <div class="brand-logo">
                <div class="logo-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="logo-text">
                    Instructor Information<br />
                    System
                </div>
            </div>

            <div class="brand-content">

                <span class="brand-tag">MANAGEMENT PORTAL</span>

                <h1>Manage Information.<br />Simplify Your Work.</h1>

                <p>
                    A centralized platform designed to organize,
                    manage, and maintain instructor information
                    efficiently and securely.
                </p>

            </div>

            <div class="brand-bottom">
                <i class="bi bi-shield-check"></i>
                &nbsp; Instructor Management System
            </div>

        </div>

        <!-- RIGHT LOGIN PANEL -->

        <div class="form-panel">

            <div class="form-heading">
                <div class="small-label">ACCOUNT ACCESS</div>

                <h2>Welcome back!</h2>

                <p>Sign in to access your instructor management portal.</p>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    @TempData["Message"]
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger small mb-3 validation-summary">
                </div>

                <div class="mb-3">

                    <label asp-for="EmailOrId" class="form-label">
                        Email Address or Account ID
                    </label>

                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>

                        <input asp-for="EmailOrId"
                               class="form-control"
                               placeholder="Enter your email or ID"
                               autocomplete="username" />
                    </div>

                    <span asp-validation-for="EmailOrId"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <div class="input-wrapper">
                        <i class="bi bi-lock"></i>

                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword()"
                                aria-label="Show or hide password">
                                                    <i class="bi bi-eye" id="passwordIcon"></i>
                        </button>
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit" class="btn-login">
                    Sign In
                    <i class="bi bi-arrow-right ms-2"></i>
                </button>

            </form>

            <div class="register-section">
                Don't have an account?
                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-link">
                    Create an account
                </a>
            </div>

        </div>

    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("passwordInput");
            const passwordIcon = document.getElementById("passwordIcon");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                passwordIcon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                passwordInput.type = "password";
                passwordIcon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>