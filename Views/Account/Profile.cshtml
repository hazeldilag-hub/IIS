
@{
    ViewData["Title"] = "My Profile";

    var firstName = ViewBag.FirstName?.ToString() ?? "";
    var lastName = ViewBag.LastName?.ToString() ?? "";
    var email = ViewBag.Email?.ToString() ?? "";
    var accountId = ViewBag.AccountId?.ToString() ?? "";

    var initial = !string.IsNullOrWhiteSpace(firstName)
        ? firstName.Substring(0, 1).ToUpper()
        : "U";
}

<div class="profile-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <span class="page-label">ACCOUNT MANAGEMENT</span>
            <h2>My Profile</h2>
            <p>View and manage your personal account information.</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>
    </div>

    <!-- PROFILE CARD -->
    <div class="profile-card">

        <!-- PROFILE COVER -->
        <div class="profile-cover">
            <div class="cover-circle circle-one"></div>
            <div class="cover-circle circle-two"></div>

            <div class="cover-label">
                <i class="bi bi-person-badge"></i>
                USER PROFILE
            </div>

            <div class="profile-avatar">
                @initial
            </div>
        </div>

        <!-- PROFILE IDENTITY -->
        <div class="profile-identity">
            <div class="identity-info">
                <h3>@firstName @lastName</h3>
                <p>
                    <i class="bi bi-envelope"></i>
                    @email
                </p>
            </div>

            <span class="status-label">
                <span class="status-dot"></span>
                Active Account
            </span>
        </div>

        <div class="profile-divider"></div>

        <!-- ACCOUNT DETAILS -->
        <div class="profile-details">

            <div class="section-heading">
                <div class="section-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </div>

                <div>
                    <h5>Account Information</h5>
                    <p>Personal details associated with your account.</p>
                </div>
            </div>

            <div class="detail-grid">

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-hash"></i>
                    </div>
                    <div>
                        <span class="detail-label">Account ID</span>
                        <strong>@accountId</strong>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    <div>
                        <span class="detail-label">First Name</span>
                        <strong>@firstName</strong>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div>
                        <span class="detail-label">Last Name</span>
                        <strong>@lastName</strong>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-envelope"></i>
                    </div>
                    <div>
                        <span class="detail-label">Email Address</span>
                        <strong>@email</strong>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <span class="detail-label">Account Status</span>
                        <strong class="active-text">Active</strong>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-person-gear"></i>
                    </div>
                    <div>
                        <span class="detail-label">Account Type</span>
                        <strong>Registered User</strong>
                    </div>
                </div>

            </div>

            <!-- SECURITY NOTICE -->
            <div class="security-notice">
                <div class="security-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <div>
                    <strong>Account Security</strong>
                    <p>
                        Your password is securely stored as a hash
                        and is not displayed on this page.
                    </p>
                </div>

                <i class="bi bi-check-circle-fill security-check"></i>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="profile-actions">

                <a asp-controller="Home" asp-action="Index" class="btn-secondary">
                    <i class="bi bi-house"></i>
                    Dashboard
                </a>

                <a asp-controller="Instructors" asp-action="Index" class="btn-primary">
                    Manage Instructors
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>

        </div>
    </div>

    <div class="profile-footer">
        <i class="bi bi-shield-check"></i>
        Instructor Information System
    </div>

</div>

<style>
    :root {
        --navy: #0f172a;
        --navy-light: #1e293b;
        --teal: #0d9488;
        --teal-dark: #0f766e;
        --teal-light: #ccfbf1;
        --background: #f1f5f9;
        --text: #334155;
        --muted: #64748b;
        --border: #e2e8f0;
    }

    .profile-page {
        max-width: 1050px;
        margin: 35px auto;
        padding: 0 20px;
        color: var(--navy);
    }

    /* PAGE HEADER */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-label {
        color: var(--teal);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
    }

    .page-header h2 {
        font-size: 27px;
        font-weight: 750;
        margin: 5px 0;
        color: var(--navy);
    }

    .page-header p {
        color: var(--muted);
        font-size: 13px;
        margin: 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        border: 1px solid var(--border);
        color: var(--text);
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        background: white;
        transition: .2s;
    }

    .btn-back:hover {
        background: var(--teal-light);
        border-color: #99f6e4;
        color: var(--teal-dark);
    }

    /* PROFILE CARD */
    .profile-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 25px rgba(15, 23, 42, .05);
    }

    /* COVER */
    .profile-cover {
        height: 165px;
        background: linear-gradient(120deg, #0f172a, #134e4a, #0d9488);
        position: relative;
        overflow: hidden;
    }

    .cover-circle {
        position: absolute;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 50%;
    }

    .circle-one {
        width: 300px;
        height: 300px;
        right: -50px;
        top: -170px;
        box-shadow: 0 0 0 35px rgba(255,255,255,.035),
                    0 0 0 70px rgba(255,255,255,.025);
    }

    .circle-two {
        width: 180px;
        height: 180px;
        right: 220px;
        bottom: -130px;
    }

    .cover-label {
        position: absolute;
        right: 30px;
        top: 25px;
        color: #99f6e4;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .profile-avatar {
        position: absolute;
        bottom: -43px;
        left: 40px;
        width: 92px;
        height: 92px;
        background: var(--teal-light);
        color: var(--teal-dark);
        border: 5px solid white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
        font-weight: 750;
        box-shadow: 0 4px 15px rgba(15,23,42,.12);
    }

    /* IDENTITY */
    .profile-identity {
        padding: 55px 40px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
    }

    .identity-info h3 {
        font-size: 23px;
        font-weight: 750;
        margin-bottom: 7px;
        color: var(--navy);
    }

    .identity-info p {
        font-size: 13px;
        color: var(--muted);
        margin: 0;
    }

    .identity-info p i {
        margin-right: 5px;
        color: var(--teal);
    }

    .status-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ecfdf5;
        color: #15803d;
        padding: 8px 13px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        background: #16a34a;
        border-radius: 50%;
    }

    .profile-divider {
        border-top: 1px solid var(--border);
    }

    /* DETAILS */
    .profile-details {
        padding: 30px 40px 35px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
    }

    .section-icon {
        width: 43px;
        height: 43px;
        background: var(--teal-light);
        color: var(--teal-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 19px;
    }

    .section-heading h5 {
        font-size: 16px;
        font-weight: 750;
        margin: 0 0 4px;
        color: var(--navy);
    }

    .section-heading p {
        font-size: 12px;
        color: var(--muted);
        margin: 0;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 10px;
        transition: .2s;
        min-width: 0;
    }

    .detail-item:hover {
        background: #f0fdfa;
        border-color: #99f6e4;
        transform: translateY(-2px);
    }

    .detail-icon {
        width: 39px;
        height: 39px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border: 1px solid #ccfbf1;
        color: var(--teal);
        border-radius: 9px;
        font-size: 16px;
    }

    .detail-label {
        display: block;
        font-size: 11px;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .detail-item strong {
        font-size: 13px;
        font-weight: 700;
        color: var(--navy-light);
        overflow-wrap: anywhere;
    }

    .active-text {
        color: #15803d !important;
    }

    /* SECURITY */
    .security-notice {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #f0fdfa;
        border: 1px solid #ccfbf1;
        padding: 18px;
        border-radius: 10px;
        margin-top: 25px;
    }

    .security-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        background: #ccfbf1;
        color: var(--teal-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 20px;
    }

    .security-notice strong {
        font-size: 13px;
        color: var(--teal-dark);
    }

    .security-notice p {
        font-size: 12px;
        color: var(--muted);
        margin: 4px 0 0;
    }

    .security-check {
        color: #16a34a;
        margin-left: auto;
        font-size: 19px;
    }

    /* ACTIONS */
    .profile-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        flex-wrap: wrap;
    }

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 17px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: .2s;
    }

    .btn-primary {
        background: var(--teal);
        color: white;
    }

    .btn-primary:hover {
        background: var(--teal-dark);
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13,148,136,.2);
    }

    .btn-secondary {
        border: 1px solid var(--border);
        color: var(--text);
        background: white;
    }

    .btn-secondary:hover {
        background: #f0fdfa;
        border-color: #99f6e4;
        color: var(--teal-dark);
    }

    /* FOOTER */
    .profile-footer {
        text-align: center;
        color: #94a3b8;
        font-size: 11px;
        margin-top: 22px;
    }

    .profile-footer i {
        color: var(--teal);
        margin-right: 5px;
    }

    /* RESPONSIVE */
    @@media (max-width: 600px) {
        .profile-page {
            margin: 20px auto;
            padding: 0 14px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-cover {
            height: 130px;
        }

        .profile-avatar {
            left: 22px;
        }

        .cover-label {
            right: 18px;
            font-size: 9px;
        }

        .profile-identity,
        .profile-details {
            padding-left: 22px;
            padding-right: 22px;
        }

        .profile-identity {
            align-items: flex-start;
            flex-direction: column;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }

        .profile-actions {
            flex-direction: column;
        }

        .profile-actions a {
            width: 100%;
        }

        .security-notice {
            align-items: flex-start;
        }
    }
</style>
