 @{
    ViewData["Title"] = "Dashboard";

    var totalInstructors = ViewBag.TotalInstructors is int count
        ? count : 0;

    var firstName = User.FindFirst("FirstName")?.Value ?? "User";
    var lastName = User.FindFirst("LastName")?.Value ?? "";
    var email = User.Identity?.Name ?? "";

    var initial = string.IsNullOrWhiteSpace(firstName)
        ? "U"
        : firstName.Substring(0, 1).ToUpper();
}

<div class="dashboard-page">

    <!-- WELCOME SECTION -->

    <div class="welcome-section">

        <div class="welcome-content">
            <span class="welcome-label">
                <i class="bi bi-grid-1x2-fill"></i>
                DASHBOARD OVERVIEW
            </span>

            <h2>Welcome back, @firstName!</h2>

            <p>
                Manage your instructor information and account activities
                through your centralized management dashboard.
            </p>

            <a asp-controller="Instructors"
               asp-action="Index"
               class="welcome-button">
                Explore Instructors
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="welcome-avatar">
            @initial
        </div>

        <div class="welcome-decoration"></div>

    </div>

    <!-- DASHBOARD STATISTICS AND ACTIONS -->

    <div class="section-heading">
        <div>
            <span class="section-label">MANAGEMENT CENTER</span>
            <h4>System Overview</h4>
        </div>
    </div>

    <div class="dashboard-grid">

        <!-- TOTAL INSTRUCTORS -->

        <div class="dashboard-card total-card">

            <div class="card-top">
                <div>
                    <span class="card-label">TOTAL INSTRUCTORS</span>
                    <h1>@totalInstructors</h1>
                    <p>Registered instructor records</p>
                </div>

                <div class="card-icon blue-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>

            <div class="card-divider"></div>

            <a asp-controller="Instructors"
               asp-action="Index"
               class="card-link">
                View all instructors
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

        <!-- ADD INSTRUCTOR -->

        <div class="dashboard-card action-card">

            <div class="card-icon cyan-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h5>Add New Instructor</h5>

            <p>
                Register a new instructor and add their personal
                and professional information.
            </p>

            <a asp-controller="Instructors"
               asp-action="Create"
               class="dashboard-button">
                Add Instructor
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

        <!-- MANAGE RECORDS -->

        <div class="dashboard-card action-card">

            <div class="card-icon navy-icon">
                <i class="bi bi-clipboard-data-fill"></i>
            </div>

            <h5>Manage Records</h5>

            <p>
                Search, view, edit, and manage existing
                instructor information.
            </p>

            <a asp-controller="Instructors"
               asp-action="Index"
               class="dashboard-button navy-button">
                Manage Records
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>

    <!-- ACCOUNT INFORMATION -->

    <div class="account-card">

        <div class="account-header">

            <div class="account-title">
                <div class="account-icon">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>

                <div>
                    <h5>Account Information</h5>
                    <p>Your registered account details.</p>
                </div>
            </div>

            <span class="account-status">
                <span class="status-dot"></span>
                Active Account
            </span>

        </div>

        <div class="account-details">

            <div class="account-detail">
                <div class="detail-icon">
                    <i class="bi bi-person"></i>
                </div>

                <div>
                    <span>First Name</span>
                    <strong>@firstName</strong>
                </div>
            </div>

            <div class="account-detail">
                <div class="detail-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <div>
                    <span>Last Name</span>
                    <strong>@lastName</strong>
                </div>
            </div>

            <div class="account-detail">
                <div class="detail-icon">
                    <i class="bi bi-envelope"></i>
                </div>

                <div>
                    <span>Email Address</span>
                    <strong>@email</strong>
                </div>
            </div>

        </div>

        <div class="account-footer">

            <div>
                <strong>Personal Account Settings</strong>
                <p>View your registered account information.</p>
            </div>

            <a asp-controller="Account"
               asp-action="Profile"
               class="profile-button">
                <i class="bi bi-person-circle"></i>
                View My Profile
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </div>

</div>

<style>

