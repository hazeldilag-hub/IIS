        box-shadow: 0 0 0 35px rgba(255,255,255,.025),
                    0 0 0 70px rgba(255,255,255,.02);
    }

    /* SECTION HEADING */

    .section-heading {
        margin-bottom: 17px;
    }

    .section-label {
        color: #2563eb;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.4px;
    }

    .section-heading h4 {
        color: #0f172a;
        font-size: 19px;
        font-weight: 750;
        margin: 5px 0 0;
    }

    /* DASHBOARD GRID */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap