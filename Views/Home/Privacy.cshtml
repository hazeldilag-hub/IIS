 @{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <!-- PAGE HEADER -->

    <div class="privacy-header">
        <div class="header-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>

        <div>
            <span class="header-label">INSTRUCTOR INFORMATION SYSTEM</span>
            <h2>Privacy Policy</h2>
            <p>
                Learn how your account information is collected,
                used, and protected within our system.
            </p>
        </div>
    </div>

    <!-- PRIVACY CONTENT -->

    <div class="privacy-card">

        <div class="policy-intro">
            <div class="intro-icon">
                <i class="bi bi-info-circle-fill"></i>
            </div>

            <div>
                <h5>Your Privacy Matters</h5>
                <p>
                    This Privacy Policy explains how the Instructor
                    Information System handles the information provided
                    by registered users and how it is used to support
                    the system's functionality.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">01</div>

            <div>
                <h5>Information We Collect</h5>
                <p>
                    The system collects information submitted during
                    account registration, including first name,
                    last name, and email address. It also stores
                    instructor information entered by authorized users.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">02</div>

            <div>
                <h5>How We Use Your Information</h5>
                <p>
                    Collected information is used to provide account
                    access, manage instructor records, identify
                    registered users, and support the main features
                    of the Instructor Information System.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">03</div>

            <div>
                <h5>Account Security</h5>
                <p>
                    User passwords are stored using secure password
                    hashing rather than plain text. Users should keep
                    their login credentials confidential and avoid
                    sharing their accounts with others.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">04</div>

            <div>
                <h5>Information Protection</h5>
                <p>
                    The system is designed to restrict access to
                    account and instructor management features
                    through its authentication process. Users should
                    log out after using the system, especially on
                    shared computers.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">05</div>

            <div>
                <h5>Information Accuracy</h5>
                <p>
                    Registered users should provide accurate
                    information when creating accounts and managing
                    instructor records. Incorrect information may
                    affect the accuracy of the system's records.
                </p>
            </div>
        </div>

        <div class="policy-section">
            <div class="section-number">06</div>

            <div>
                <h5>Policy Updates</h5>
                <p>
                    This Privacy Policy may be updated when changes
                    are made to the system's features, information
                    handling practices, or security procedures.
                </p>
            </div>
        </div>

        <!-- SECURITY NOTICE -->

        <div class="privacy-notice">
            <i class="bi bi-shield-check"></i>

            <div>
                <strong>Important Reminder</strong>
                <p>
                    Protect your account credentials and make sure
                    you access the system through authorized means.
                </p>
            </div>
        </div>

        <!-- FOOTER -->

        <div class="privacy-footer">
            <span>
                <i class="bi bi-lock-fill"></i>
                Instructor Information System
            </span>

            <span>© @DateTime.Now.Year All Rights Reserved</span>
        </div>

    </div>

</div>

<style>
    .privacy-page {
        max-width: 1000px;
        margin: 35px auto;
        padding: 0 20px 30px;
        color: #0f172a;
    }

    /* HEADER */

    .privacy-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 27px;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        min-width: 60px;
        border-radius: 13px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .header-label {
        color: #2563eb;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .privacy-header h2 {
        font-size: 27px;
        font-weight: 750;
        margin: 5px 0;
        color: #0f172a;
    }

    .privacy-header p {
        color: #64748b;
        font-size: 13px;
        margin: 0;
    }

    /* MAIN CARD */

    .privacy-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        padding: 32px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, .04);
    }

    /* INTRO */

    .policy-intro {
        display: flex;
        gap: 15px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
    }

    .intro-icon {
        color: #2563eb;
        font-size: 22px;
    }

    .policy-intro h5 {
        color: #1e40af;
        font-size: 15px;
        font-weight: 750;
        margin-bottom: 7px;
    }

    .policy-intro p {
        color: #475569;
        font-size: 12px;
        line-height: 1.8;
        margin: 0;
    }

    /* POLICY SECTIONS */

    .policy-section {
        display: flex;
        gap: 17px;
        padding: 20px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .section-number {
        width: 39px;
        height: 39px;
        min-width: 39px;
        border-radius: 9px;
        background: #f1f5f9;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
    }

    .policy-section h5 {
        color: #0f172a;
        font-size: 14px;
        font-weight: 750;
        margin: 2px 0 7px;
    }

    .policy-section p {
        color: #64748b;
        font-size: 12px;
        line-height: 1.9;
        margin: 0;
    }

    /* NOTICE */

    .privacy-notice {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        padding: 17px;
        border-radius: 9px;
        margin-top: 27px;
    }

    .privacy-notice > i {
        color: #16a34a;
        font-size: 22px;
    }

    .privacy-notice strong {
        color: #166534;
        font-size: 13px;
    }

    .privacy-notice p {
        color: #4b5563;
        font-size: 12px;
        margin: 5px 0 0;
        line-height: 1.7;
    }

    /* FOOTER */

    .privacy-footer {
        display: flex