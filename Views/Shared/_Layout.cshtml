
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var navFirst = User.FindFirst("FirstName")?.Value ?? "User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Information System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        :root {
            --primary: #14532d;
            --primary-hover: #166534;
            --accent: #4d7c0f;
            --cream: #f5f5dc;
            --background: #f8faf5;
            --white: #ffffff;
            --text: #26352b;
            --muted: #647568;
            --border: #e5e7df;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: var(--background) !important;
            color: var(--text);
        }

        /* SIDEBAR */

        body.has-sidebar > .sidebar {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            bottom: 0 !important;
            width: 250px !important;
            height: 100vh !important;
            display: flex !important;
            flex-direction: column !important;
            flex-wrap: nowrap !important;
            background: var(--primary) !important;
            color: white;
            z-index: 1050;
            border: none !important;
            border-right: 1px solid rgba(255,255,255,.10) !important;
            overflow-y: auto;
        }

        .sidebar-brand {
            min-height: 75px;
            padding: 0 22px;
            display: flex !important;
            align-items: center;
            gap: 12px;
            color: white !important;
            text-decoration: none !important;
            font-size: 16px;
            font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,.12);
        }

        .sidebar-brand i {
            color: #d9f99d;
            font-size: 23px;
        }

        .sidebar-brand:hover {
            color: var(--cream) !important;
        }

        /* NAVIGATION */

        .sidebar-nav {
            width: 100%;
            padding: 20px 12px;
            display: flex !important;
            flex-direction: column !important;
            flex-wrap: nowrap !important;
            gap: 7px;
        }

        .sidebar-nav a {
            width: 100%;
            min-height: 48px;
            display: flex !important;
            flex-direction: row !important;
            align-items: center;
            justify-content: flex-start;
            gap: 13px;
            padding: 12px 14px;
            color: #e5eee6 !important;
            text-decoration: none !important;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 500;
            transition: background .2s ease;
        }

        .sidebar-nav a i {
            width: 22px;
            font-size: 18px;
            text-align: center;
        }

        .sidebar-nav a:hover {
            background: rgba(255,255,255,.10) !important;
            color: white !important;
        }

        .sidebar-nav a.active {
            background: var(--cream) !important;
            color: var(--primary) !important;
            font-weight: 700;
        }

        .sidebar-nav a.active i {
            color: var(--primary) !important;
        }

        /* SIDEBAR FOOTER */

        .sidebar-footer {
            width: 100%;
            margin-top: auto;
            padding: 16px 12px 20px;
            border-top: 1px solid rgba(255,255,255,.12);
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0 10px 16px;
            color: white;
            font-size: 14px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .sidebar-user i {
            color: #d9f99d;
            font-size: 19px;
        }

        .sidebar-footer form {
            width: 100%;
            margin: 0;
        }

        .logout-button {
            width: 100%;
            min-height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 10px;
            background: transparent;
            color: #fecaca;
            border: 1px solid rgba(248,113,113,.55);
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            transition: .2s;
        }

        .logout-button:hover {
            background: #991b1b;
            color: white;
            cursor: pointer;
        }

        /* MAIN CONTENT */

        body.has-sidebar > .content-wrap {
            margin-left: 250px !important;
            width: calc(100% - 250px);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        body.no-sidebar > .content-wrap {
            width: 100%;
            min-height: calc(100vh - 68px);
            display: flex;
            flex-direction: column;
        }

        .main-content {
            width: 100%;
            min-width: 0;
            flex: 1;
            padding: 25px;
        }

        .site-footer {
            padding: 15px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            background: white;
            border-top: 1px solid var(--border);
        }

        /* LOGIN / REGISTER HEADER */

        .site-header {
            min-height: 68px;
            width: 100%;
            background: var(--primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 28px;
        }

        .site-brand {
            color: white !important;
            font-size: 17px;
            font-weight: 700;
            text-decoration: none !important;
        }

        .site-brand i {
            color: #d9f99d;
        }

        .site-nav {
            display: flex;
            gap: 10px;
        }

        .site-nav a {
            padding: 9px 16px;
            color: #e5eee6 !important;
            text-decoration: none !important;
            border-radius: 7px;
            font-size: 14px;
        }

        .site-nav a:hover,
        .site-nav a.active {
            background: var(--cream);
            color: var(--primary) !important;
        }

        /* GENERAL THEME */

        .card {
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(20,83,45,.04);
        }

        .btn-primary,
        .btn-success {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover,
        .btn-success:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
        }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(77,124,15,.12);
        }

        /* MOBILE */

        @@media (max-width: 768px) {
            body.has-sidebar > .sidebar {
                position: relative !important;
                width: 100% !important;
                height: auto !important;
                min-height: auto;
                bottom: auto !important;
                overflow: visible;
            }

            .sidebar-brand {
                min-height: 60px;
            }

            .sidebar-nav {
                flex-direction: row !important;
                flex-wrap: wrap !important;
                padding: 10px;
            }

            .sidebar-nav a {
                flex: 1 1 auto;
                width: auto;
                justify-content: center;
                font-size: 12px;
                padding: 10px;
            }

            .sidebar-footer {
                margin-top: 0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
            }

            .sidebar-user {
                padding: 5px;
            }

            .sidebar-footer form {
                width: auto;
            }

            .logout-button {
                width: auto;
                padding: 9px 14px;
            }

            body.has-sidebar > .content-wrap {
                margin-left: 0 !important;
                width: 100%;
            }

            .main-content {
                padding: 15px;
            }
        }

        @@media (max-width: 480px) {
            .site-header {
                padding: 0 12px;
            }

            .site-brand {
                font-size: 14px;
            }

            .site-nav {
                gap: 3px;
            }

            .site-nav a {
                padding: 8px 10px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body class="@(isAuth ? "has-sidebar" : "no-sidebar")">

    @if (isAuth)
    {
        <aside class="sidebar">

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-brand">
                <i class="bi bi-mortarboard-fill"></i>
                <span>Information System</span>
            </a>

            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(controller == "Home" ? "active" : "")">
                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Instructors"
                   asp-action="Index"
                   class="@(controller == "Instructors" ? "active" : "")">
                    <i class="bi bi-people"></i>
                    <span>Instructors</span>
                </a>

                <a asp-controller="Account"
                   asp-action="Profile"
                   class="@(controller == "Account" && action == "Profile" ? "active" : "")">
                    <i class="bi bi-person"></i>
                    <span>My Profile</span>
                </a>

            </nav>

            <div class="sidebar-footer">

                <div class="sidebar-user">
                    <i class="bi bi-person-circle"></i>
                    <span>@navFirst</span>
                </div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout-button">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </button>

                </form>

            </div>

        </aside>
    }
    else
    {
        <header class="site-header">

            <a asp-controller="Account"
               asp-action="Login"
               class="site-brand">
                <i class="bi bi-mortarboard-fill me-2"></i>
                Information System
            </a>

            <nav class="site-nav">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="@(action == "Login" ? "active" : "")">
                    Login
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="@(action == "Register" ? "active" : "")">
                    Register
                </a>

            </nav>

        </header>
    }

    <div class="content-wrap">

        <main class="main-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Information System
            </p>
        </footer>

    </div>

    @if (TempData["Message"] is string message)
    {
        <div data-popup-message="@message" hidden></div>
    }

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
